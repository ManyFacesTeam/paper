	author = {Voegeli, Rainer and Schoop, Rotraut and Prestat-Marquis, Elodie and Rawlings, Anthony V. and Shackelford, Todd K. and Fink, Bernhard},
	year = {2021},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/ics.12727},
	keywords = {perception, face, cross-cultural, ethnicity, chronological age, perceived age, women},
	pages = {547--560},
	file = {Full Text PDF:/Users/thora/Zotero/storage/Y9EF45TI/Voegeli et al. - 2021 - Differences between perceived age and chronological age in women A multi-ethnic and multi-centre st.pdf:application/pdf;Snapshot:/Users/thora/Zotero/storage/2GXI8VLY/ics.html:text/html},
